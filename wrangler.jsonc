{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitkit",
  "compatibility_date": "2026-08-15",

  // The Cloudflare project connected to this repo is a Worker: Workers Builds
  // runs `npx wrangler deploy` on a clean checkout with no build step of its
  // own. Wrangler runs this command first, so dist/ exists before upload.
  "build": {
    "command": "npm run build",
  },

  // A static-assets Worker: no script, just dist/. Unmatched paths get the app
  // shell so client-side routes load directly. Workers Assets rejects the
  // `/* /index.html 200` rule in a _redirects file as an infinite loop, so SPA
  // routing is configured here instead. Headers still come from _headers.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
