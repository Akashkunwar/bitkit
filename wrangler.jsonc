{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitkit",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  // Wrangler only runs its framework-detection setup (which builds for you)
  // when there is no config file. With this file committed it goes straight to
  // deploy, so the build has to be declared here or `dist` will not exist.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // Workers Assets serves index.html for any unmatched path, which is what a
    // client-routed SPA needs. A `_redirects` rule doing the same thing is
    // rejected as a loop: Workers normalises `/index.html` back to `/`, which
    // re-triggers the rule. This setting replaces that file entirely.
    "not_found_handling": "single-page-application"
  }
}
