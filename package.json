{
  "name": "bitkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "npm run icons && npm run og && npm run sitemap",
    "icons": "node scripts/generate-icons.mjs",
    "og": "node scripts/generate-og.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=bitkit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "dexie": "^4.0.11",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.2.6",
    "js-yaml": "^5.3.0",
    "jspdf": "^3.0.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "marked": "^15.0.12",
    "mermaid": "^11.16.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "smol-toml": "^1.8.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.0.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  },
  "description": "65 privacy-first browser tools. Images, PDFs, data, media, and code utilities that run entirely on your device.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
